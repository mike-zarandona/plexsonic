[Unit]
Description=Plexsonic Now Playing Display
Documentation=https://github.com/your-username/plexsonic
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/plexsonic
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /home/pi/plexsonic/backend/dist/server.js
Restart=on-failure
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=plexsonic

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/plexsonic/data

[Install]
WantedBy=multi-user.target
