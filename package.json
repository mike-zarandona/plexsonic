{
  "name": "plexsonic",
  "version": "1.0.0",
  "description": "Real-time music Now Playing display for Plex",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspace=backend"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
